# Godot 4+ ignores
# Editor cache & build artifacts (regenerated on import)
.godot/
.import/

# Per-file metadata generated by Godot (.import sidecars, .uid script IDs)
*.import
*.uid

# Mono / C# build artifacts (not used by this project, but standard)
.mono/
data_*/

# Exports (out of scope for the prototype)
*.exe
*.pck
*.zip
